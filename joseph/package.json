{
  "name": "joseph-revideo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "revideo serve",
    "render": "node scripts/render.mjs --out=narrated.mp4 && node scripts/mix-music.mjs narrated.mp4 josephs-amazing-coat.mp4 --switch=136 && rm -f narrated.mp4",
