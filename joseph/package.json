    "voiceover": "node scripts/build-voiceover.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.0.0",
    "@fontsource/nunito": "^5.0.0",
    "@revideo/2d": "0.11.0",
    "@revideo/cli": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "^0.11.0"
  }
}
