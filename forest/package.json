    "placeholders": "python3 scripts/make-placeholders.py"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.0.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.0.0",
    "@revideo/2d": "0.11.0",
    "@revideo/cli": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "^0.11.0"
  }
}
