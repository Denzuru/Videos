{
  "name": "quiet-growth-revideo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "revideo serve",
    "render": "node scripts/render.mjs --out=silent.mp4 && node scripts/add-music.mjs silent.mp4 quiet-growth.mp4 && rm -f silent.mp4",
